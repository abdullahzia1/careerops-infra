# Local .terraform directories
**/.terraform/*

# Terraform lock file (commit this if you want reproducible provider versions)
# .terraform.lock.hcl

# Terraform state files — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Terraform plan files — contain sensitive data
*.tfplan
tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Vars files that may contain secrets
*.tfvars
*.tfvars.json
!*.example.tfvars

# CLI config
.terraformrc
terraform.rc

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo
